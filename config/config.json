    "C1_CNN_BiGRU_Q":  {"RMSE": 216.69, "MAE": 108.67, "MAPE": 1.2425, "R2": 0.9747, "PICP_raw": 0.9481, "PICP_cqr": 0.9155, "q_hat": -47.12},
    "C1_DTAQ":         {"RMSE": 214.58, "MAE": 109.20, "MAPE": 1.2416, "R2": 0.9752, "PICP_raw": 0.9032, "PICP_cqr": 0.9165, "q_hat": 14.84},
    "C2_LSTM_Q":       {"RMSE": 206.54, "MAE": 104.51, "MAPE": 1.2079, "R2": 0.9771, "PICP_raw": 0.9056, "PICP_cqr": 0.8851, "q_hat": -11.57},
    "C2_CNN_BiGRU_Q":  {"RMSE": 199.99, "MAE": 105.17, "MAPE": 1.2087, "R2": 0.9785, "PICP_raw": 0.9378, "PICP_cqr": 0.9126, "q_hat": -23.05},
    "C2_DTAQ":         {"RMSE": 173.88, "MAE":  77.16, "MAPE": 0.9035, "R2": 0.9837, "PICP_raw": 0.8791, "PICP_cqr": 0.8926, "q_hat": 6.96},
    "C3_LSTM_Q":       {"RMSE": 207.11, "MAE":  98.13, "MAPE": 1.1301, "R2": 0.9769, "PICP_raw": 0.9138, "PICP_cqr": 0.8951, "q_hat": -12.61},
    "C3_CNN_BiGRU_Q":  {"RMSE": 189.34, "MAE":  90.48, "MAPE": 1.0390, "R2": 0.9807, "PICP_raw": 0.9424, "PICP_cqr": 0.9234, "q_hat": -21.05},
    "C3_DTAQ":         {"RMSE": 173.82, "MAE":  75.55, "MAPE": 0.8860, "R2": 0.9837, "PICP_raw": 0.8382, "PICP_cqr": 0.8824, "q_hat": 17.75}
  }
}
